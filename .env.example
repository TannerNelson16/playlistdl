# Base download directory on the server
AUDIO_DOWNLOAD_PATH=/your/folder/path

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password

# Optional: Spotify API credentials to avoid rate limits
# SPOTIPY_CLIENT_ID=your_spotify_client_id
# SPOTIPY_CLIENT_SECRET=your_spotify_client_secret

# Audio providers for spotdl (space-separated, e.g. youtube-music youtube soundcloud piped bandcamp)
# Default is youtube-music youtube soundcloud for best speed, quality, and fallback reliability
SPOTDL_AUDIO_PROVIDERS=youtube-music youtube soundcloud

# Optional: Extra arguments to pass to spotdl (e.g. --dont-filter-results)
SPOTDL_EXTRA_ARGS=--dont-filter-results

# Cleanup interval in seconds (default: 86400 = 24 hours)
CLEANUP_INTERVAL=86400

# Optional: Comma-separated list of download folder options for the Admin dropdown.
# Can be simple paths or Label:Path pairs, e.g.:
# DOWNLOAD_OPTIONS=Pop:/path/to/Music/Pop,Rock:/path/to/Music/Rock,General Conference:/path/to/Music/General_Conference/
DOWNLOAD_OPTIONS=Artist:/path/to/Music/Artist/,General Conference:/path/to/Music/General_Conference/
